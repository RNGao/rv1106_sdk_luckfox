#!/bin/sh
# BLE advertising is owned by the manually started /ble_test/ble_test program.
# Keep this init entry inert so existing firmware overlays cannot advertise at
# boot or compete with the GATT test server.

case "${1:-}" in
    start)
        echo "[BLE] Boot advertising disabled; run /ble_test/ble_test manually"
        ;;
    stop)
        echo "[BLE] Advertising is controlled by /ble_test/ble_test"
        ;;
    status)
        /oem/usr/bin/btmgmt advinfo
        ;;
    *)
        echo "Usage: $0 {start|stop|status}" >&2
        exit 1
        ;;
esac
