CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGER=y
CONFIG_IIO_TRIGGERED_BUFFER=y
# Preempt kernel work when the 500 SPS ADS1299 reader becomes runnable.
# CONFIG_PREEMPT_NONE is not set
CONFIG_PREEMPT=y
# The driver is built externally by this project's Makefile.
# CONFIG_ADS1299_MYBOARD is not set
