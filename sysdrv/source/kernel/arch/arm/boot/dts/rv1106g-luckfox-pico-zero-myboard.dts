#include "rv1106g-luckfox-pico-zero.dts"

/ {
	model = "Luckfox Pico Zero MyBoard (ADS1299)";

	pcm5102a: pcm5102a {
		compatible = "ti,pcm5102a";
		#sound-dai-cells = <0>;
	};

	pcm5102a_sound: pcm5102a-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "pcm5102a";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,bitclock-master = <&pcm5102a_cpu>;
		simple-audio-card,frame-master = <&pcm5102a_cpu>;
		pcm5102a_cpu: simple-audio-card,cpu {
			sound-dai = <&i2s0_8ch>;
		};
		simple-audio-card,codec {
			sound-dai = <&pcm5102a>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&keys_pins>;

		key-gpio1-c7 {
			label = "gpio1-c7";
			gpios = <&gpio1 RK_PC7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_1>;
			debounce-interval = <20>;
		};

		key-gpio0-a3 {
			label = "gpio0-a3";
			gpios = <&gpio0 RK_PA3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_2>;
			debounce-interval = <20>;
		};

		key-gpio0-a4 {
			label = "gpio0-a4";
			gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_3>;
			debounce-interval = <20>;
		};
	};
};

/* The schematic connects VDD_ARM to the fixed VDD_0V9 rail through R70. */
&vdd_arm {
	regulator-min-microvolt = <900000>;
	regulator-max-microvolt = <900000>;
};

/* GPIO2_A0/A1/A2/A4 are shared with the SD card's SDMMC1 M0 pins. */
&sdio {
	status = "disabled";
};

&acodec_sound {
	status = "disabled";
};

&acodec {
	status = "disabled";
};

&i2s0_8ch {
	pinctrl-names = "default";
	pinctrl-0 = <&pcm5102a_i2s0_pins>;
	rockchip,playback-only;
	status = "okay";
};

/* Keep automatic scaling within the board's existing 1.104 GHz ceiling. */
&cpu0_opp_table {
	/delete-node/ opp-1200000000;
	/delete-node/ opp-1296000000;
	/delete-node/ opp-1416000000;
	/delete-node/ opp-1512000000;
	/delete-node/ opp-1608000000;
};

&leds {
	pinctrl-names = "default";
	pinctrl-0 = <&led_gpio0_a0>;

	led-gpio0-a0 {
		label = "gpio0-a0";
		gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		default-state = "off";
	};
};

&spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi0m0_clk &spi0m0_mosi &spi0m0_miso &spi0m0_cs0>;
	/delete-node/ spidev@0;

	ads1299: adc@0 {
		compatible = "ti,ads1299";
		reg = <0>;
		spi-max-frequency = <4000000>;
		spi-cpha;
		pinctrl-names = "default";
		pinctrl-0 = <&ads1299_control &ads1299_drdy>;
		start-gpios = <&gpio1 RK_PD1 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio1 RK_PD0 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio1 RK_PB1 GPIO_ACTIVE_LOW>;
		drdy-gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_LOW>;
	};
};

&i2c3 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m0_xfer>;

	icm20948: imu@68 {
		compatible = "invensense,icm20948";
		reg = <0x68>;
		pinctrl-names = "default";
		pinctrl-0 = <&icm20948_int>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PC6 IRQ_TYPE_EDGE_FALLING>;
	};
};

&pinctrl {
	i2s0 {
		pcm5102a_i2s0_pins: pcm5102a-i2s0-pins {
			rockchip,pins = <2 RK_PA0 2 &pcfg_pull_none>, /* BCK */
					<2 RK_PA1 2 &pcfg_pull_none>, /* LRCK */
					<2 RK_PA2 2 &pcfg_pull_none>, /* SCK */
					<2 RK_PA4 2 &pcfg_pull_none>; /* DIN */
		};
	};

	keys {
		keys_pins: keys-pins {
			rockchip,pins = <1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
				       <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>,
				       <0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	leds {
		led_gpio0_a0: led-gpio0-a0 {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	ads1299 {
		ads1299_control: ads1299-control {
			rockchip,pins = <1 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>,
				       <1 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>,
				       <1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		ads1299_drdy: ads1299-drdy {
			rockchip,pins = <1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	icm20948 {
		icm20948_int: icm20948-int {
			rockchip,pins = <1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
